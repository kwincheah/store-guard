<UserControl x:Class="StoreGuard.Desktop.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="{DynamicResource AppBgBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filter Bar -->
        <Border Grid.Row="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="0,0,0,12" ClipToBounds="True">
            <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Margin="0,3,12,3">
                    <TextBlock Text="From" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding FromDate}" Width="134"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,12,3">
                    <TextBlock Text="To" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <DatePicker SelectedDate="{Binding ToDate}" Width="134"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,12,3">
                    <TextBlock Text="Camera" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding CameraFilters}"
                              SelectedValue="{Binding SelectedCameraFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              Width="156"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,3,12,3">
                    <TextBlock Text="Verdict" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,6,0"/>
                    <ComboBox ItemsSource="{Binding VerdictFilters}"
                              SelectedValue="{Binding SelectedVerdictFilter}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              Width="144"/>
                </StackPanel>
                <Button Content="Refresh" Style="{StaticResource BaseButtonStyle}" Command="{Binding RefreshCommand}" Margin="0,3,8,3"/>
                <Button Content="Export CSV" Style="{StaticResource BaseButtonStyle}" Command="{Binding ExportCsvCommand}" Margin="0,3,12,3"/>
                <TextBlock Text="{Binding StatusText}" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,3"/>
            </WrapPanel>
        </Border>

        <!-- Table + Enriched Incident Inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" MinWidth="440"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}"
                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="TIME" Binding="{Binding LocalTimeDisplay}" Width="138">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CAMERA" Binding="{Binding CameraName}" Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="CONF" Binding="{Binding ConfidenceDisplay}" Width="66">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment" Value="Right"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTemplateColumn Header="VERDICT" Width="134">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border BorderThickness="1" CornerRadius="8" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Verdict}" Value="ConfirmedTheft">
                                                        <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Verdict}" Value="FalseAlarm">
                                                        <Setter Property="Background" Value="{DynamicResource OkTintBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding VerdictDisplay}" FontSize="11" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="ConfirmedTheft">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="FalseAlarm">
                                                            <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="NOTE" Binding="{Binding ReviewNote}" Width="1.4*">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                    <Setter Property="FontSize" Value="12"/>
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" ClipToBounds="True">
                <Grid>
                    <!-- Empty State -->
                    <TextBlock Text="Select any record to inspect evidence frames, 10s video clip, and triage notes." FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"
                               Visibility="{Binding SelectedItem, Converter={StaticResource NullToVis}}"/>

                    <Grid Visibility="{Binding SelectedItem, Converter={StaticResource NotNullToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Anchored Metadata Header + Media Switcher -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedItem.CameraName}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SelectedItem.LocalTimeDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                                </StackPanel>
                                <Border Grid.Column="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Height="32" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Grid" Style="{StaticResource SegmentedButtonStyle}" Padding="9,2" MinHeight="24" GroupName="HistoryMediaMode"
                                                     IsChecked="{Binding IsGridMode, Mode=OneWay}" Command="{Binding ToggleGridViewCommand}"/>
                                        <RadioButton Content="10s Clip" Style="{StaticResource SegmentedButtonStyle}" Padding="9,2" MinHeight="24" GroupName="HistoryMediaMode"
                                                     IsChecked="{Binding ShowClipMode, Mode=OneWay}"
                                                     IsEnabled="{Binding CanPlaySelectedClip}"
                                                     ToolTipService.ShowOnDisabled="True"
                                                     ToolTip="{Binding SelectedItem.PlayClipTooltip}"
                                                     Command="{Binding PlayClipCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedItem.ConfidenceDisplay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}"/>
                                </Border>
                                <Border BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedItem.Verdict}" Value="ConfirmedTheft">
                                                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedItem.Verdict}" Value="FalseAlarm">
                                                    <Setter Property="Background" Value="{DynamicResource OkTintBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedItem.VerdictDisplay}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedItem.Verdict}" Value="ConfirmedTheft">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedItem.Verdict}" Value="FalseAlarm">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                                <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                           Visibility="{Binding SelectedItem.ReviewedBy, Converter={StaticResource StrToVis}}">
                                    <Run Text="Reviewed by "/><Run Text="{Binding SelectedItem.ReviewedBy, Mode=OneWay}"/>
                                </TextBlock>
                            </WrapPanel>
                        </StackPanel>

                        <Border Grid.Row="1" Background="{DynamicResource MediaBgBrush}" CornerRadius="8" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding SelectedItem.GridPath, Converter={StaticResource PathToBmp}}" Stretch="Uniform"
                                       Visibility="{Binding ShowClipMode, Converter={StaticResource InvertBoolToVis}}"/>
                                <vlc:VideoView x:Name="HistoryClipVideoView" Visibility="{Binding ShowClipMode, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>

                        <!-- AI Summary + Full Staff Review Note -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,10,0,10">
                            <ScrollViewer MaxHeight="104" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,8,0">
                                    <TextBlock Text="AI AUDIT SUMMARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                    <TextBlock Text="{Binding SelectedItem.Justification}" TextWrapping="Wrap" FontSize="12" LineHeight="18" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Margin="0,8,0,0" Visibility="{Binding SelectedItem.HasReviewNote, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="STAFF REVIEW NOTE" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource OkTextBrush}" Margin="0,0,0,2"/>
                                        <TextBlock Text="{Binding SelectedItem.ReviewNote}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <!-- Quick Re-Triage Row -->
                        <Grid Grid.Row="3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ReviewNoteInput, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Update audit note..." Margin="0,0,8,0"/>
                            <Button Grid.Column="1" Content="False Alarm" Style="{StaticResource SuccessOutlineButtonStyle}" Padding="10,6" Margin="0,0,6,0"
                                    Command="{Binding MarkFalseAlarmCommand}"/>
                            <Button Grid.Column="2" Content="Confirm Theft" Style="{StaticResource DangerButtonStyle}" Padding="10,6"
                                    Command="{Binding ConfirmTheftCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
