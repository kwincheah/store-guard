<UserControl x:Class="StoreGuard.Desktop.Views.RoiCanvasEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource MediaBgBrush}">
    <Viewbox Stretch="Uniform">
        <Grid x:Name="ImageSurface" Width="1280" Height="720" ClipToBounds="True"
              Background="Transparent" Cursor="Cross"
              MouseLeftButtonDown="Surface_MouseLeftButtonDown"
              MouseMove="Surface_MouseMove"
              MouseLeftButtonUp="Surface_MouseLeftButtonUp"
              LostMouseCapture="Surface_LostMouseCapture">
            <Image x:Name="SnapshotImg" Stretch="Fill" IsHitTestVisible="False"/>
            <Border x:Name="EmptyHintOverlay" IsHitTestVisible="False"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="24,14" Opacity="0.94">
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="No preview frame loaded yet"
                               FontSize="24" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,6"/>
                    <TextBlock Text="Drag anywhere here to draw an ROI, or click Save Camera &amp; Reload / Grab Snapshot"
                               FontSize="16"
                               Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <Canvas x:Name="OverlayCanvas" Background="Transparent" IsHitTestVisible="False"/>
        </Grid>
    </Viewbox>
</UserControl>
