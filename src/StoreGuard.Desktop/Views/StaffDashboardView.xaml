<UserControl x:Class="StoreGuard.Desktop.Views.StaffDashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
             Background="{DynamicResource AppBgBrush}"
             PreviewKeyDown="UserControl_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Clean Inline Camera Status Strip -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="0,2" ClipToBounds="True">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding HasCameras, Converter={StaticResource InvertBoolToVis}}">
                    <TextBlock Text="No cameras configured yet."
                               FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Open Camera Setup" Style="{StaticResource BaseButtonStyle}" MinHeight="28" Padding="10,4"
                            Command="{Binding DataContext.OpenCameraSetupCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                </StackPanel>

                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                              Visibility="{Binding HasCameras, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding CameraHealths}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,5" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="7" Height="7" Fill="{Binding State, Converter={StaticResource HealthToBrush}}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" MaxWidth="160" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Fps, StringFormat={}{0:F1} fps}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Master-Detail Alert Queue & Evidence Inspector -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="336" MinWidth="280" MaxWidth="440"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*" MinWidth="420"/>
            </Grid.ColumnDefinitions>

            <!-- Left Alert Queue -->
            <Border Grid.Column="0" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12" ClipToBounds="True">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="2,0,2,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Live Alert Queue" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="9,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Alerts.Count, StringFormat={}{0} events}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Border>
                    </Grid>

                    <ListBox ItemsSource="{Binding Alerts}" SelectedItem="{Binding SelectedAlert}"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Grid>
                                                <Border x:Name="Card" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                                    <ContentPresenter/>
                                                </Border>
                                                <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusBorderBrush}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource PrimaryBorderBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsKeyboardFocused" Value="True">
                                                    <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <!-- Semantic Left Rail -->
                                    <Border Grid.Column="0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{DynamicResource WarnBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Verdict}" Value="ConfirmedTheft">
                                                        <Setter Property="Background" Value="{DynamicResource DangerBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Verdict}" Value="FalseAlarm">
                                                        <Setter Property="Background" Value="{DynamicResource OkBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                    </Border>
                                    <Grid Grid.Column="1" Margin="11,10,12,10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding CameraName}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ConfidenceDisplay}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}"/>
                                            </Border>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding LocalTimeDisplay}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,6" TextTrimming="CharacterEllipsis"/>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding BehaviorsDisplay}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                            <Border Grid.Column="1" BorderThickness="1" CornerRadius="8" Padding="8,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Verdict}" Value="ConfirmedTheft">
                                                                <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Verdict}" Value="FalseAlarm">
                                                                <Setter Property="Background" Value="{DynamicResource OkTintBrush}"/>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding VerdictDisplay}" FontSize="11" FontWeight="SemiBold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Verdict}" Value="ConfirmedTheft">
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Verdict}" Value="FalseAlarm">
                                                                    <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- Right Evidence Inspector -->
            <Border Grid.Column="2" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" ClipToBounds="True">
                <Grid>
                    <!-- Empty State -->
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                Visibility="{Binding SelectedAlert, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="All Clear — Monitoring Active Streams" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                        <TextBlock Text="Detected alerts, 2x3 behavioral sequence grids, and 10s evidence MP4 clips will appear here automatically." FontSize="12" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="420" TextAlignment="Center"/>
                    </StackPanel>

                    <!-- Detail View -->
                    <Grid Visibility="{Binding SelectedAlert, Converter={StaticResource NotNullToVis}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Two-tier Responsive Header (never clips badges at 1120px) -->
                        <StackPanel Grid.Row="0" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding SelectedAlert.CameraName}" FontSize="16" FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="0,0,12,0"/>

                                <Border Grid.Column="1" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Height="34" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <RadioButton Content="2x3 Sequence Grid" Style="{StaticResource SegmentedButtonStyle}" GroupName="InspectorMediaMode"
                                                     IsChecked="{Binding IsGridMode, Mode=OneWay}" Command="{Binding ToggleGridViewCommand}"/>
                                        <RadioButton Content="Play 10s Clip" Style="{StaticResource SegmentedButtonStyle}" GroupName="InspectorMediaMode"
                                                     IsChecked="{Binding ShowClipMode, Mode=OneWay}"
                                                     IsEnabled="{Binding CanPlaySelectedClip}"
                                                     ToolTipService.ShowOnDisabled="True"
                                                     ToolTip="{Binding SelectedAlert.PlayClipTooltip}"
                                                     Command="{Binding PlayClipCommand}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <WrapPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                    <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}">
                                        <Run Text="Track #"/><Run Text="{Binding SelectedAlert.TrackId, Mode=OneWay}"/>
                                    </TextBlock>
                                </Border>
                                <Border Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,2" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding SelectedAlert.ConfidenceDisplay, StringFormat=Confidence {0}}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}"/>
                                </Border>
                                <Border BorderThickness="1" CornerRadius="4" Padding="8,2">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WarnTintBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedAlert.Verdict}" Value="ConfirmedTheft">
                                                    <Setter Property="Background" Value="{DynamicResource DangerTintBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding SelectedAlert.Verdict}" Value="FalseAlarm">
                                                    <Setter Property="Background" Value="{DynamicResource OkTintBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding SelectedAlert.VerdictDisplay}" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SelectedAlert.Verdict}" Value="ConfirmedTheft">
                                                        <Setter Property="Foreground" Value="{DynamicResource DangerTextBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SelectedAlert.Verdict}" Value="FalseAlarm">
                                                        <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </WrapPanel>
                        </StackPanel>

                        <!-- Chronological Evidence Viewport -->
                        <Border Grid.Row="1" Background="{DynamicResource MediaBgBrush}" CornerRadius="8" ClipToBounds="True">
                            <Grid>
                                <Image Source="{Binding SelectedAlert.GridPath, Converter={StaticResource PathToBmp}}" Stretch="Uniform"
                                       Visibility="{Binding ShowClipMode, Converter={StaticResource InvertBoolToVis}}"/>
                                <vlc:VideoView x:Name="ClipVideoView" Visibility="{Binding ShowClipMode, Converter={StaticResource BoolToVis}}"/>
                            </Grid>
                        </Border>

                        <!-- AI Reasoning Summary -->
                        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" CornerRadius="8" Padding="12,10" Margin="0,10,0,10">
                            <StackPanel>
                                <TextBlock Text="AI AUDIT SUMMARY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,4"/>
                                <ScrollViewer MaxHeight="76" VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding SelectedAlert.Justification}" TextWrapping="Wrap" FontSize="12" LineHeight="18"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>

                        <!-- Non-blocking Undo Toast -->
                        <Border Grid.Row="3" Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}"
                                BorderThickness="1" CornerRadius="8" Padding="12,6" Margin="0,0,0,8"
                                Visibility="{Binding ShowUndoToast, Converter={StaticResource BoolToVis}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding UndoToastMessage}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Undo" Style="{StaticResource BaseButtonStyle}" MinHeight="26" Padding="10,2"
                                        Command="{Binding UndoLastVerdictCommand}"/>
                            </Grid>
                        </Border>

                        <!-- Staff Verdict Bar -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" Text="{Binding ReviewNoteInput, UpdateSourceTrigger=PropertyChanged}"
                                     Tag="Staff triage note (e.g., paid at counter)..." Margin="0,0,10,0"/>
                            <Button Grid.Column="1" Content="False Alarm (F)" Style="{StaticResource SuccessOutlineButtonStyle}" Margin="0,0,8,0"
                                    ToolTip="Mark as False Alarm (Shortcut: F)"
                                    Command="{Binding MarkFalseAlarmCommand}"/>
                            <Button Grid.Column="2" Content="Confirm Theft (C)" Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="Confirm Theft incident (Shortcut: C)"
                                    Command="{Binding ConfirmTheftCommand}"/>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
