<UserControl x:Class="StoreGuard.Desktop.Views.SecretInputBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="RootControl"
             MinHeight="34">
    <Border x:Name="FrameBd"
            Background="{DynamicResource InputBgBrush}"
            BorderBrush="{DynamicResource StrongBorderBrush}"
            BorderThickness="1"
            CornerRadius="4"
            MinHeight="34">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RootControl}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootControl}" Value="True">
                        <Setter Property="BorderBrush" Value="{DynamicResource FocusBorderBrush}"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="10,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="PlaceholderText"
                           Text="{Binding Placeholder, ElementName=RootControl}"
                           Foreground="{DynamicResource TextMutedBrush}"
                           Opacity="0.90"
                           FontSize="12"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           IsHitTestVisible="False"/>

                <PasswordBox x:Name="SecretPasswordBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             MinHeight="32"
                             VerticalContentAlignment="Center"
                             FontSize="14"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             CaretBrush="{DynamicResource FocusBorderBrush}"
                             PasswordChanged="SecretPasswordBox_PasswordChanged">
                    <PasswordBox.Template>
                        <ControlTemplate TargetType="PasswordBox">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </PasswordBox.Template>
                </PasswordBox>

                <TextBox x:Name="PlainTextBox"
                         Visibility="Collapsed"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         MinHeight="32"
                         VerticalContentAlignment="Center"
                         FontSize="12"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         CaretBrush="{DynamicResource FocusBorderBrush}"
                         TextChanged="PlainTextBox_TextChanged">
                    <TextBox.Template>
                        <ControlTemplate TargetType="TextBox">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="0" VerticalAlignment="Center"/>
                        </ControlTemplate>
                    </TextBox.Template>
                </TextBox>
            </Grid>

            <ToggleButton x:Name="RevealToggle"
                          Grid.Column="1"
                          Width="32" Height="32"
                          Margin="2,0"
                          Cursor="Hand"
                          Focusable="True"
                          IsChecked="{Binding IsRevealed, ElementName=RootControl, Mode=TwoWay}"
                          ToolTip="Show or hide secret"
                          AutomationProperties.Name="Toggle secret visibility">
                <ToggleButton.Template>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="BtnBd" Background="Transparent" CornerRadius="4">
                                <Path x:Name="EyeIcon"
                                      Data="M 1 8 C 3.5 3.5 12.5 3.5 15 8 C 12.5 12.5 3.5 12.5 1 8 Z M 8 5.5 A 2.5 2.5 0 1 0 8 10.5 A 2.5 2.5 0 1 0 8 5.5 Z"
                                      Stroke="{DynamicResource TextMutedBrush}"
                                      StrokeThickness="1.5"
                                      Fill="Transparent"
                                      Width="16" Height="16" Stretch="Uniform"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusBorderBrush}" BorderThickness="2"
                                    CornerRadius="4" Visibility="Collapsed" IsHitTestVisible="False"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource CardHoverBrush}"/>
                                <Setter TargetName="EyeIcon" Property="Stroke" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="BtnBd" Property="Background" Value="{DynamicResource PrimaryTintBrush}"/>
                                <Setter TargetName="EyeIcon" Property="Stroke" Value="{DynamicResource PrimaryTextBrush}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </ToggleButton.Template>
            </ToggleButton>
        </Grid>
    </Border>
</UserControl>
