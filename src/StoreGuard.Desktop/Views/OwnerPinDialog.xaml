<Window x:Class="StoreGuard.Desktop.Views.OwnerPinDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Admin Authentication — StoreGuard" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Background="{DynamicResource AppBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}">
    <Border Margin="16" Background="{DynamicResource PanelBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
        <StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,16">
                <Border Width="40" Height="40" CornerRadius="8" Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" Margin="0,0,12,0">
                    <Path Data="M 5 8 V 5 A 5 5 0 0 1 15 5 V 8 H 17 V 18 H 3 V 8 Z M 7 8 H 13 V 5 A 3 3 0 0 0 7 5 Z"
                          Fill="{DynamicResource FocusBorderBrush}" Width="16" Height="16" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Admin Authentication" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Admin configuration &amp; .apex flow controls" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="Admin PIN" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6"/>
            <PasswordBox x:Name="PinBox" Margin="0,0,0,8" KeyDown="PinBox_KeyDown" PasswordChanged="PinBox_PasswordChanged"/>

            <Border x:Name="ErrorBanner" Visibility="Collapsed"
                    Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="0,0,0,10">
                <TextBlock x:Name="ErrorText" Text="Incorrect Admin PIN. Try again."
                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"/>
            </Border>

            <TextBlock x:Name="DefaultPinHintText"
                       Text="Default PIN is 1234. Change it in Compute, VLM &amp; Alerts."
                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"
                       Margin="0,0,0,16" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Cancel" IsCancel="True" Style="{StaticResource BaseButtonStyle}" MinWidth="92" Margin="0,0,8,0" Click="Cancel_Click"/>
                <Button x:Name="UnlockButton" Content="Unlock Settings" IsDefault="True" Style="{StaticResource PrimaryButtonStyle}" MinWidth="128" Click="Unlock_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
