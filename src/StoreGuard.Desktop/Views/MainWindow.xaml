<Window x:Class="StoreGuard.Desktop.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StoreGuard.Desktop.Views"
        Title="StoreGuard — Retail CCTV Security Operations"
        Height="860" Width="1400" MinHeight="680" MinWidth="1120"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        Background="{DynamicResource AppBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="216"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,1,0" ClipToBounds="True">
            <DockPanel Margin="12,16">
                <!-- Brand Identity + Engine Link Pill -->
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,20">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource PrimaryTintBrush}" BorderBrush="{DynamicResource PrimaryBorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                            <Path Data="M 16 6 L 25 10 V 17 C 25 22 21 26 16 27 C 11 26 7 22 7 17 V 10 Z"
                                  Fill="{DynamicResource FocusBorderBrush}" Stretch="Uniform" Margin="7"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="StoreGuard" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Theft Detection" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Border Background="{DynamicResource PanelBgBrush}" CornerRadius="8" Padding="10,7" Margin="0,14,0,0"
                            BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" ToolTip="{Binding EngineBanner}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource WarnBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsEngineConnected}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding EngineBanner}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Bottom Engine Telemetry Card -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="ENGINE TELEMETRY" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,4"/>
                        <TextBlock Text="{Binding GpuMetricsText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding DeviceFallbackHint}" FontSize="11" Foreground="{DynamicResource WarnTextBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0"
                                   Visibility="{Binding DeviceFallbackHint, Converter={StaticResource StrToVis}}"/>
                    </StackPanel>
                </Border>

                <!-- Primary Navigation Buttons -->
                <StackPanel>
                    <TextBlock Text="OPERATIONS" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,0,0,8"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}" GroupName="NavRail"
                                 IsChecked="{Binding IsNavAlerts, Mode=OneWay}"
                                 Command="{Binding SelectNavTabCommand}" CommandParameter="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M 10 2 A 6 6 0 0 1 16 8 V 13 L 18 15 V 16 H 2 V 15 L 4 13 V 8 A 6 6 0 0 1 10 2 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="15" Height="15" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Counter Alerts" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="2" Background="{DynamicResource DangerTintBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="7,1" Margin="6,0,0,0">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding UnreviewedCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding UnreviewedCount}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}"/>
                            </Border>
                        </Grid>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}" GroupName="NavRail"
                                 IsChecked="{Binding IsNavLiveGrid, Mode=OneWay}"
                                 Command="{Binding SelectNavTabCommand}" CommandParameter="1">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 2 2 H 8 V 8 H 2 Z M 10 2 H 16 V 8 H 10 Z M 2 10 H 8 V 16 H 2 Z M 10 10 H 16 V 16 H 10 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="Live Grid" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}" GroupName="NavRail"
                                 IsChecked="{Binding IsNavHistory, Mode=OneWay}"
                                 Command="{Binding SelectNavTabCommand}" CommandParameter="2">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M 2 4 H 16 V 6 H 2 Z M 2 9 H 16 V 11 H 2 Z M 2 14 H 11 V 16 H 2 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Text="History &amp; Audit" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </RadioButton>

                    <TextBlock Text="ADMINISTRATION" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="8,16,0,8"/>

                    <RadioButton Style="{StaticResource SidebarNavButtonStyle}" GroupName="NavRail"
                                 IsChecked="{Binding IsNavOwner, Mode=OneWay}"
                                 Command="{Binding SelectNavTabCommand}" CommandParameter="3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Path Grid.Column="0" Data="M 5 8 V 5 A 5 5 0 0 1 15 5 V 8 H 17 V 18 H 3 V 8 Z M 7 8 H 13 V 5 A 3 3 0 0 0 7 5 Z"
                                  Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,10,0"/>
                            <TextBlock Grid.Column="1" Text="Admin Settings" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            <Border Grid.Column="2" Background="{DynamicResource WarnTintBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1" Margin="6,0,0,0"
                                    Visibility="{Binding IsOwnerUnlocked, Converter={StaticResource InvertBoolToVis}}">
                                <TextBlock Text="PIN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarnTextBrush}"/>
                            </Border>
                        </Grid>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Right Main Workspace -->
        <Grid Grid.Column="1" ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="60"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Command Bar -->
            <Border Grid.Row="0" Background="{DynamicResource SidebarBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="0,0,0,1" Padding="16,0" ClipToBounds="True">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <TextBlock Text="{Binding ActivePageTitle}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ActivePageSubtitle}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- Admin-Only Hardware Switcher (hidden from counter staff until Admin unlock) -->
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Visibility="{Binding IsOwnerUnlocked, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Compute" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource SubtleBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,8,0" Height="34">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <RadioButton Content="Auto" Style="{StaticResource SegmentedButtonStyle}" GroupName="DeviceSwitch"
                                                 Padding="8,3"
                                                 IsChecked="{Binding IsDeviceAuto, Mode=OneWay}"
                                                 Command="{Binding SelectDeviceCommand}" CommandParameter="auto"/>
                                    <RadioButton Content="CPU" Style="{StaticResource SegmentedButtonStyle}" GroupName="DeviceSwitch"
                                                 Padding="8,3"
                                                 IsChecked="{Binding IsDeviceCpu, Mode=OneWay}"
                                                 Command="{Binding SelectDeviceCommand}" CommandParameter="cpu"/>
                                    <RadioButton Content="GPU" Style="{StaticResource SegmentedButtonStyle}" GroupName="DeviceSwitch"
                                                 Padding="8,3"
                                                 IsChecked="{Binding IsDeviceGpu, Mode=OneWay}"
                                                 Command="{Binding SelectDeviceCommand}" CommandParameter="cuda:0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Active Hardware Status Pill -->
                        <Border CornerRadius="8" Padding="10,0" Height="34" Margin="0,0,8,0" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource SubtleBorderBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsUsingGpu}" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource OkTintBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource OkBorderBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUsingGpu}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource OkBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="{Binding ActiveHardwareBadge}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUsingGpu}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <!-- Dark / Light Theme Switcher -->
                        <Button Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding ToggleThemeCommand}"
                                Height="34" MinHeight="34" Padding="10,0" Margin="0,0,8,0"
                                ToolTip="Switch between Dark and Light appearance">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center">
                                    <Path.Style>
                                        <Style TargetType="Path">
                                            <Setter Property="Data" Value="M 10 2 A 6 6 0 1 0 16 11 A 5 5 0 0 1 10 2 Z"/>
                                            <Setter Property="Fill" Value="{DynamicResource ButtonFgBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                    <Setter Property="Data" Value="M 8 4 A 4 4 0 1 0 8 12 A 4 4 0 1 0 8 4 Z"/>
                                                    <Setter Property="Fill" Value="{DynamicResource ButtonFgBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Path.Style>
                                </Path>
                                <TextBlock FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Dark"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLightTheme}" Value="True">
                                                    <Setter Property="Text" Value="Light"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>

                        <!-- Admin Lock Button (neutral style in header bar) -->
                        <Button Style="{StaticResource BaseButtonStyle}"
                                Command="{Binding LockOwnerCommand}"
                                Height="34" MinHeight="34" Padding="10,0" Margin="0,0,8,0"
                                Visibility="{Binding IsOwnerUnlocked, Converter={StaticResource BoolToVis}}"
                                ToolTip="Lock Admin settings (requires PIN to reopen)">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="M 5 8 V 5 A 5 5 0 0 1 15 5 V 8 H 17 V 18 H 3 V 8 Z M 7 8 H 13 V 5 A 3 3 0 0 0 7 5 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Lock Admin" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Sound Mute Toggle Pill -->
                        <ToggleButton IsChecked="{Binding IsSoundMuted}" Height="34" Padding="12,0" Cursor="Hand" FocusVisualStyle="{x:Null}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Grid>
                                        <Border x:Name="Bd" Background="{DynamicResource OkActionBrush}" BorderBrush="{DynamicResource OkBorderBrush}" BorderThickness="1" CornerRadius="8" MinWidth="104" Padding="{TemplateBinding Padding}">
                                            <TextBlock x:Name="Lbl" Text="Sound: ON" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource OnOkActionBrush}" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                                        </Border>
                                        <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusBorderBrush}" BorderThickness="2" CornerRadius="8" Visibility="Collapsed" IsHitTestVisible="False"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerActionBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource DangerBorderBrush}"/>
                                            <Setter TargetName="Lbl" Property="Text" Value="Sound: MUTED"/>
                                            <Setter TargetName="Lbl" Property="Foreground" Value="{DynamicResource OnDangerActionBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Non-blocking VLM / Push Warning Banner -->
            <Border Grid.Row="1" Background="{DynamicResource WarnTintBrush}" BorderBrush="{DynamicResource WarnBorderBrush}" BorderThickness="0,0,0,1" Padding="16,8"
                    Visibility="{Binding VlmWarningBanner, Converter={StaticResource StrToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding VlmWarningBanner}" Foreground="{DynamicResource WarnTextBrush}" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    <Button Grid.Column="1" Content="Dismiss" Style="{StaticResource BaseButtonStyle}" MinHeight="28" Padding="10,3"
                            Command="{Binding DismissVlmWarningCommand}"/>
                </Grid>
            </Border>

            <!-- View Content Host -->
            <Grid Grid.Row="2" ClipToBounds="True">
                <views:StaffDashboardView DataContext="{Binding AlertFeed}" Visibility="{Binding DataContext.IsNavAlerts, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:LiveGridView DataContext="{Binding LiveGrid}" Visibility="{Binding DataContext.IsNavLiveGrid, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:HistoryView DataContext="{Binding History}" Visibility="{Binding DataContext.IsNavHistory, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"/>
                <views:OwnerSettingsView x:Name="OwnerSettingsPanel" DataContext="{Binding}" IsEnabled="{Binding IsOwnerUnlocked}">
                    <views:OwnerSettingsView.Style>
                        <Style TargetType="views:OwnerSettingsView">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding IsNavOwner}" Value="True"/>
                                        <Condition Binding="{Binding IsOwnerUnlocked}" Value="True"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Visible"/>
                                </MultiDataTrigger>
                            </Style.Triggers>
                        </Style>
                    </views:OwnerSettingsView.Style>
                </views:OwnerSettingsView>
            </Grid>
        </Grid>
    </Grid>
</Window>
