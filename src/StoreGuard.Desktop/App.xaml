<Application x:Class="StoreGuard.Desktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:StoreGuard.Desktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/DesignTokens.xaml"/>
                <ResourceDictionary Source="Styles/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <conv:BoolToVisibilityConverter x:Key="BoolToVis"/>
            <conv:BoolToVisibilityConverter x:Key="InvertBoolToVis" Invert="True"/>
            <conv:NullToVisibilityConverter x:Key="NotNullToVis"/>
            <conv:NullToVisibilityConverter x:Key="NullToVis" Invert="True"/>
            <conv:StringNotEmptyToVisibilityConverter x:Key="StrToVis"/>
            <conv:PathToBitmapConverter x:Key="PathToBmp"/>
            <conv:BytesToBitmapConverter x:Key="BytesToBmp"/>
            <conv:HealthStateToBrushConverter x:Key="HealthToBrush"/>
            <conv:VerdictToBrushConverter x:Key="VerdictToBrush"/>
            <conv:VerdictToTintBrushConverter x:Key="VerdictToTintBrush"/>
            <conv:VerdictToTextBrushConverter x:Key="VerdictToTextBrush"/>
            <conv:VerdictToBorderBrushConverter x:Key="VerdictToBorderBrush"/>
            <conv:VerdictToAccentBrushConverter x:Key="VerdictToAccentBrush"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
