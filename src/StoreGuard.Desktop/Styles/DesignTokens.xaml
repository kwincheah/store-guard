<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Slate Graphite Dark Surfaces (Calibrated for WCAG AA >= 4.5:1 text & >= 3.0:1 UI boundaries) -->
    <SolidColorBrush x:Key="AppBgBrush" Color="#0D1015"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#11151C"/>
    <SolidColorBrush x:Key="PanelBgBrush" Color="#161B24"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#1C2330"/>
    <SolidColorBrush x:Key="CardHoverBrush" Color="#242D3D"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#0F131A"/>
    <SolidColorBrush x:Key="MediaBgBrush" Color="#090B0F"/>
    <SolidColorBrush x:Key="AltRowBgBrush" Color="#19202B"/>
    <SolidColorBrush x:Key="SubtleBorderBrush" Color="#263042"/>
    <SolidColorBrush x:Key="StrongBorderBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="FocusBorderBrush" Color="#38BDF8"/>
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#0D1015"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#475569"/>

    <!-- Typography Scale -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8"/>
    <SolidColorBrush x:Key="TextDisabledBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnOkActionBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="OnDangerActionBrush" Color="#FFFFFF"/>

    <!-- Filled Neutral Buttons (Darker fill + crisp #FFFFFF text = 13.0:1) -->
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#253042"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#334155"/>
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#475569"/>
    <SolidColorBrush x:Key="ButtonFgBrush" Color="#FFFFFF"/>

    <!-- Primary Precision Sky-Blue (#075985 = 7.56:1 w/ #FFFFFF) -->
    <SolidColorBrush x:Key="PrimaryBrush" Color="#075985"/>
    <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0369A1"/>
    <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#0C4A6E"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#7DD3FC"/>
    <SolidColorBrush x:Key="PrimaryTintBrush" Color="#0C2A3E"/>
    <SolidColorBrush x:Key="PrimaryBorderBrush" Color="#0284C7"/>

    <!-- Semantic Accents (Darker solid action fills + #FFFFFF text) -->
    <SolidColorBrush x:Key="OkBrush" Color="#10B981"/>
    <SolidColorBrush x:Key="OkActionBrush" Color="#065F46"/>
    <SolidColorBrush x:Key="OkHoverBrush" Color="#047857"/>
    <SolidColorBrush x:Key="OkPressedBrush" Color="#064E3B"/>
    <SolidColorBrush x:Key="OkTextBrush" Color="#6EE7B7"/>
    <SolidColorBrush x:Key="OkTintBrush" Color="#0B2E26"/>
    <SolidColorBrush x:Key="OkBorderBrush" Color="#115E49"/>

    <SolidColorBrush x:Key="WarnBrush" Color="#F59E0B"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#FCD34D"/>
    <SolidColorBrush x:Key="WarnTintBrush" Color="#322108"/>
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#78350F"/>

    <SolidColorBrush x:Key="DangerBrush" Color="#F43F5E"/>
    <SolidColorBrush x:Key="DangerActionBrush" Color="#9F1239"/>
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#BE123C"/>
    <SolidColorBrush x:Key="DangerPressedBrush" Color="#881337"/>
    <SolidColorBrush x:Key="DangerTextBrush" Color="#FDA4AF"/>
    <SolidColorBrush x:Key="DangerTintBrush" Color="#35101A"/>
    <SolidColorBrush x:Key="DangerBorderBrush" Color="#881337"/>

    <!-- ROI Canvas Overlays -->
    <SolidColorBrush x:Key="ShelfBrush" Color="#FB923C"/>
    <SolidColorBrush x:Key="AisleBrush" Color="#38BDF8"/>
</ResourceDictionary>
